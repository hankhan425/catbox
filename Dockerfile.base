FROM elixir:1.19.5-otp-28-alpine

# Install system dependencies
RUN apk add --no-cache \
    curl \
    git \
    nodejs \
    npm \
    build-base \
    inotify-tools \
    bubblewrap \
    socat \
    bash

# Install Claude Code globally
RUN npm install -g @anthropic-ai/claude-code

# Create non-root user
RUN adduser -D -s /bin/bash user

# Build the agent release
WORKDIR /opt/agent
COPY agent/mix.exs agent/mix.lock* ./
RUN mix local.hex --force && mix local.rebar --force
RUN MIX_ENV=prod mix deps.get --only prod
COPY agent/config config/
COPY agent/lib lib/
RUN MIX_ENV=prod mix release

# Ensure user home is owned correctly
RUN chown -R user:user /home/user

# Make agent release readable by user (agent runs as non-root)
RUN chmod -R a+rX /opt/agent/_build/prod/rel/workspace_agent

# Install hex and rebar for the user (needed for Phoenix project bootstrap)
USER user
RUN mix local.hex --force && mix local.rebar --force

EXPOSE 4000 9090

# Run as non-root user
CMD ["/opt/agent/_build/prod/rel/workspace_agent/bin/workspace_agent", "start"]
